# HHG Oasis Control Tower — environment template
# Copy to .env and fill values. Never commit real secrets.

# Single database for Control Tower + CRM (crm_* tables in same Postgres).
DATABASE_URL=

# Signed session cookie (min 16 chars). Required for auth.
HHG_SESSION_SECRET=

# Initial account passwords for prisma/seed-users.ts (hashed server-side).
# Do not use weak/default passwords in production.
HHG_PASSWORD_NGHIAPHAM=
HHG_PASSWORD_TIENPHAM=
HHG_PASSWORD_MICAHPHAM=
HHG_PASSWORD_HOANGLE=
HHG_PASSWORD_ANHNAM=
HHG_PASSWORD_ADMINISTRATION=

# Shared password for zone-desk accounts (MIAOI, VIP, PICKLEBALL, SPA, GYM, JACUZZI).
# Seed: npx tsx prisma/seed-desk-zones.ts
HHG_PASSWORD_DESK_ZONES=

# Optional: OpenAI for AI lập hạng mục Task (hhgoasispromptask via APP1 mainAI).
# Without this key, API falls back to rule-based plan (still writes Prisma).
# Put real OPENAI_API_KEY only in .env — never in this example file.
# Prefer model gpt6.1-sol. Pipeline: mainAI (web+domain) → OpenAI direct → rule_based.
OPENAI_API_KEY=
OPENAI_MODEL=gpt6.1-sol
# HHG_OASIS_USE_MAINAI=1
# HHG_OASIS_MAINAI_WEB=1
# HHG_OASIS_PYTHON=c.o-chatbot/APP1/.venv/bin/python3

# Customer App (/customer-app) — same DATABASE_URL. Session secret min 16 chars.
# CUSTOMER_SESSION_SECRET=
# Optional: dedicated secret for remember-device cookie hashing (falls back to session secret).
# CUSTOMER_DEVICE_SECRET=
# NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3001
