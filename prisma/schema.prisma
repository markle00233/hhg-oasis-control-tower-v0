generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Unit {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects    Project[]
  tasks       Task[]
  dailyCloses DailyClose[]
  expenses    Expense[]
  issues      Issue[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  category  String?
  owner     String?
  budget    Float?
  deadline  String?
  readiness Int      @default(0)
  status    String   @default("ON_TRACK")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitId    String?
  unit      Unit?      @relation(fields: [unitId], references: [id])
  tasks     Task[]
  decisions Decision[]
}

model Task {
  id        String   @id @default(cuid())
  code      String?
  title     String
  priority  String   @default("P2")
  owner     String?
  deadline  String?
  status    String   @default("TODO")
  cost      Float?
  blocker   String?
  progress  Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitId          String?
  unit            Unit?      @relation(fields: [unitId], references: [id])
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id])
  events          TaskEvent[]
  decisions       Decision[]
  expenses        Expense[]
  sourceMessageId String?
  sourceDraftId   String?
}

model TaskEvent {
  id        String   @id @default(cuid())
  label     String
  detail    String?
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Decision {
  id             String    @id @default(cuid())
  code           String?   @unique
  title          String
  description    String?
  amountLabel    String?
  proposer       String?
  approver       String?
  deadline       String?
  impact         String?
  isBlocking     Boolean   @default(true)
  status         String    @default("PENDING") // PENDING | APPROVED | NEEDS_INFO | REJECTED
  resolutionNote String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  linkedTaskId    String?
  linkedTask      Task?     @relation(fields: [linkedTaskId], references: [id])
  linkedProjectId String?
  linkedProject   Project?  @relation(fields: [linkedProjectId], references: [id])
}

model DailyClose {
  id            String   @id @default(cuid())
  date          String
  revenue       Float    @default(0)
  cashCollected Float    @default(0)
  guestCount    Int?
  source        String   @default("MANUAL")
  note          String?
  status        String   @default("PROVISIONAL")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  @@unique([unitId, date])
}

model Expense {
  id              String   @id @default(cuid())
  code            String?
  /// Technical code: OPERATING | MAINTENANCE | IMPROVEMENT | ASSET_PURCHASE | SHARED | UNCLASSIFIED
  category        String
  /// Vietnamese label shown in UI
  categoryLabel   String?
  amount          Float
  content         String?
  source          String?
  taskRef         String?
  status          String   @default("PROVISIONAL")
  aiSuggestion    String?
  aiConfidence    Int?
  humanConfirmed  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unitId       String?
  unit         Unit?   @relation(fields: [unitId], references: [id])
  linkedTaskId String?
  linkedTask   Task?   @relation(fields: [linkedTaskId], references: [id])
}

model Issue {
  id        String   @id @default(cuid())
  category  String
  note      String?
  areaLabel String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])
}

model MessageInbox {
  id                 String   @id @default(cuid())
  sourceChannel      String   @default("manual")
  rawText            String
  senderDisplayName  String?
  status             String   @default("NEW") // NEW | ANALYZED | REVIEWED | ARCHIVED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  drafts AiTaskDraft[]
}

model AiTaskDraft {
  id                 String   @id @default(cuid())
  parentGroup        String?
  suggestedTitle     String
  suggestedUnit      String?
  suggestedType      String?
  suggestedOwner     String?
  suggestedPriority  String?
  suggestedDeadline  String?
  duplicateTaskId    String?
  duplicateHint      String?
  confidence         Int      @default(70)
  reason             String?
  reviewStatus       String   @default("PENDING") // PENDING | CONFIRMED | EDITED | MERGED | SKIPPED
  createdTaskId      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  messageId String
  message   MessageInbox @relation(fields: [messageId], references: [id], onDelete: Cascade)
}
