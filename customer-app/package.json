{
  "name": "hhg-oasis-customer-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "prebuild": "prisma generate --schema=prisma/schema.prisma",
    "build": "next build",
    "vercel-build": "prisma generate --schema=prisma/schema.prisma && next build",
    "start": "next start -p 3001",
    "start:prod": "next start -p ${PORT:-3001}",
    "lint": "next lint",
    "postinstall": "prisma generate --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.3",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.12",
    "next": "^15.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.16.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
