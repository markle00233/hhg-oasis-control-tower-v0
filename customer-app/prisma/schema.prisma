// Slim schema for Customer App only (faster generate + smaller client).
// Keep in sync with App* models in root prisma/schema.prisma.
//
// DANGER: NEVER run `prisma db push` with this schema against the shared DB.
// It will drop Control Tower / CRM tables. Use ONLY:
//   npx prisma generate --schema=prisma/schema.prisma
// Schema changes: edit root prisma/schema.prisma, then
//   npx prisma db push --schema=prisma/schema.prisma
// and mirror App* models here for generate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppCustomer {
  id           String   @id @default(cuid())
  customerCode String   @unique
  username     String   @unique
  passwordHash String
  status       String   @default("ACTIVE")
  fullName        String?
  phone           String?
  phoneNormalized String?  @unique
  /// 4 số cuối — chỉ dùng recovery/lookup, không phải ID chính
  phoneLast4      String?
  /// legacy alias kept in sync with phoneLast4
  shortId         String?
  /// WALK_IN | MEMBER | VIP
  segment         String   @default("WALK_IN")
  intendedServices String?
  adminConfirmedAt DateTime?
  adminNote        String?
  /// Opaque public token for My Oasis QR (never phone / raw DB id)
  identityToken    String?  @unique
  /// Loyalty tick points (check-in +5, redeem later)
  pointsBalance    Int      @default(0)
  /// Active VIP / membership package end (null = not VIP)
  vipExpiresAt     DateTime?
  vipPlanLabel     String?
  /// When the current package started. Orders before this stay Khách lẻ.
  vipStartedAt     DateTime?
  /// Lượt bơi miễn phí còn lại trên gói VIP.
  vipChoiceTotal   Int      @default(0)
  vipChoiceLeft    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AppCustomerSession[]
  devices  AppCustomerDevice[]
  events   AppServiceEvent[]
  orders   AppOrder[]
  bookings AppBooking[]
  serviceCarts AppServiceCart[]
  collectedOffers AppCollectedOffer[]
  pointLedger AppPointLedger[]
  offerClaimLogs AppOfferClaimLog[]
  voucherRedemptions AppVoucherRedemption[]
  vipChoiceLogs    AppVipChoiceLog[]
  tournamentCheckIns AppTournamentCheckIn[]
  tournamentVouchers AppTournamentVoucher[]

  @@index([status])
  @@index([createdAt])
  @@index([shortId])
  @@index([phoneLast4])
  @@index([segment])
  @@index([phoneNormalized])
  @@map("app_customers")
}

/// Mỗi lượt tự chọn VIP đã chốt trên đơn Hồ Olympic.
model AppVipChoiceLog {
  id         String      @id @default(cuid())
  customerId String
  customer   AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Bơi miễn phí
  purpose    String
  orderId    String?
  usedAt     DateTime    @default(now())

  @@index([customerId, usedAt])
  @@index([orderId])
  @@map("app_vip_choice_logs")
}

/// Point earn / redeem ledger (idempotent per ref).
model AppPointLedger {
  id           String   @id @default(cuid())
  customerId   String
  customer     AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  /// CHECKIN | REDEEM | ADJUST
  reason       String
  /// SERVICE_EVENT | SERVICE_CART | …
  refType      String?
  refId        String?
  note         String?
  createdAt    DateTime @default(now())

  @@unique([reason, refType, refId])
  @@index([customerId, createdAt])
  @@map("app_point_ledger")
}

/// Collected promo / voucher (Ưu đãi → Collect).
model AppCollectedOffer {
  id          String    @id @default(cuid())
  customerId  String
  customer    AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offerId     String
  status      String    @default("COLLECTED") // COLLECTED | USED | CANCELLED
  /// Tổng số lần (null = không giới hạn trong hạn gói, vd Mía %)
  qtyTotal     Int?
  /// Còn lại; 0 = hết lần nhưng thẻ vẫn hiện, không dùng thêm
  qtyRemaining Int?
  collectedAt DateTime  @default(now())
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([customerId, offerId])
  @@index([customerId, status])
  @@map("app_collected_offers")
}

model AppOfferClaimLog {
  id              String   @id @default(cuid())
  customerId      String
  customer        AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offerId         String
  offerTitle      String?
  zoneCode        String
  claimedByUserId String?
  claimedByName   String?
  phoneSnapshot   String?
  note            String?
  createdAt       DateTime @default(now())

  @@index([zoneCode, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("app_offer_claim_logs")
}

/// One-time QR for a Spa / Lòng Nướng voucher. Staff scan confirms it.
model AppVoucherRedemption {
  id            String    @id @default(cuid())
  /// Opaque QR token (vr_…)
  token         String    @unique
  customerId    String
  customer      AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offerId       String
  offerTitle    String
  /// SPA | LONG_NUONG
  zoneCode      String
  /// OPEN | SCANNED
  status        String    @default("OPEN")
  claimLogId    String?
  scannedAt     DateTime?
  scannedByName String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([customerId, offerId, status])
  @@index([expiresAt])
  @@map("app_voucher_redemptions")
}

/// Multi-select basket → one QR carrying all chosen services.
model AppServiceCart {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String
  customer   AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zoneCode   String
  zoneName   String?
  items      Json
  totalVnd   Int      @default(0)
  /// PENDING_APPROVAL | OPEN | USED | REJECTED | NO_SHOW | EXPIRED | CANCELLED
  status     String   @default("PENDING_APPROVAL")
  /// Staff reject reason (when REJECTED). "Đã dùng" khi lượt đã kết thúc.
  adminNote  String?
  /// Ảnh bill giấy. Bắt buộc trước khi chốt đơn.
  billPhoto   String?
  billPhotoAt DateTime?
  /// Set when staff duyệt (or the cart is created already paid). Spa duration starts here.
  approvedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, status, createdAt])
  @@index([expiresAt])
  @@map("app_service_carts")
}

/// Remember-this-device: cookie holds raw token; DB stores hash only.
model AppCustomerDevice {
  id         String    @id @default(cuid())
  customerId String
  customer   AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  events AppServiceEvent[]

  @@index([customerId])
  @@index([expiresAt])
  @@map("app_customer_devices")
}

model AppCustomerSession {
  id           String   @id @default(cuid())
  customerId   String
  customer     AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  lastUsedAt   DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
  @@map("app_customer_sessions")
}

model AppService {
  id          String   @id @default(cuid())
  serviceCode String   @unique
  serviceName String
  slug        String?  @unique
  qrToken     String?  @unique
  status      String   @default("ACTIVE")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events    AppServiceEvent[]
  orders    AppOrder[]
  bookings  AppBooking[]
  resources AppResource[]

  @@index([status])
  @@map("app_services")
}

model AppServiceEvent {
  id         String   @id @default(cuid())
  customerId String
  customer   AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    AppService  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  deviceId   String?
  device     AppCustomerDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  eventType  String   @default("SERVICE_USE")
  /// SERVICE_USE ops: NEW | ACKNOWLEDGED | IN_SERVICE | COMPLETED | CANCELLED | WRONG_SCAN
  operationalStatus String @default("NEW")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  orders AppOrder[]

  @@index([customerId, createdAt])
  @@index([serviceId, createdAt])
  @@index([customerId, serviceId, createdAt])
  @@index([deviceId])
  @@index([operationalStatus, createdAt])
  @@map("app_service_events")
}

model AppOrder {
  id         String   @id @default(cuid())
  customerId String
  customer   AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    AppService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceUseId String?
  serviceUse   AppServiceEvent? @relation(fields: [serviceUseId], references: [id], onDelete: SetNull)
  status     String   @default("PENDING")
  totalVnd   Int      @default(0)
  note       String?
  createdByType String @default("STAFF")
  createdById   String?
  source     String   @default("ZONE_DESK")
  idempotencyKey String? @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items AppOrderItem[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([serviceUseId])
  @@map("app_orders")
}

model AppOrderItem {
  id           String @id @default(cuid())
  orderId      String
  order        AppOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       String
  nameVi       String
  nameEn       String?
  unitPriceVnd Int
  qty          Int    @default(1)

  @@index([orderId])
  @@map("app_order_items")
}

model AppResource {
  id        String   @id @default(cuid())
  serviceId String
  service   AppService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type      String
  code      String
  name      String
  capacity  Int      @default(1)
  status    String   @default("AVAILABLE")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings AppBooking[]
  sessions AppResourceSession[]

  @@unique([serviceId, code])
  @@index([serviceId, type, sortOrder])
  @@map("app_resources")
}

model AppBooking {
  id                   String    @id @default(cuid())
  bookingCode          String    @unique
  customerId           String?
  customer             AppCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerNameSnapshot String?
  phone                String?
  phoneNormalized      String?
  serviceId            String
  service              AppService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  resourceId           String?
  resource             AppResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  startAt              DateTime
  endAt                DateTime
  partySize            Int       @default(1)
  status               String    @default("CONFIRMED")
  notes                String?
  source               String    @default("STAFF")
  createdByType        String?
  createdById          String?
  serviceUseId         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sessions AppResourceSession[]

  @@index([serviceId, startAt])
  @@index([customerId, startAt])
  @@index([phoneNormalized, startAt])
  @@index([resourceId, startAt])
  @@index([status, startAt])
  @@map("app_bookings")
}

model AppResourceSession {
  id         String    @id @default(cuid())
  resourceId String
  resource   AppResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  customerId String?
  bookingId  String?
  booking    AppBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  startAt    DateTime  @default(now())
  endAt      DateTime?
  status     String    @default("OCCUPIED")
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([resourceId, status])
  @@index([bookingId])
  @@map("app_resource_sessions")
}

/// Danh sách học viên bơi (đồng bộ DB với desk).
model AppSwimStudent {
  id               String    @id @default(cuid())
  fullName         String
  phone            String?
  phoneNormalized  String?
  packageId        String
  packageLabel     String
  sessionsTotal    Int       @default(0)
  sessionsLeft     Int       @default(0)
  bonusVisitsTotal Int       @default(0)
  bonusVisitsLeft  Int       @default(0)
  /// ACTIVE | PAUSED | DONE
  status           String    @default("ACTIVE")
  note             String?
  /// Ảnh bill — bắt buộc khi chốt đơn gói học bơi.
  billPhoto        String?
  billPhotoAt      DateTime?
  startedAt        DateTime  @default(now())
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bonusLogs AppSwimBonusLog[]

  @@index([status, createdAt])
  @@index([phoneNormalized])
  @@index([fullName])
  @@map("app_swim_students")
}

/// Mỗi lần học viên dùng 1 lượt tự chọn (bơi tự do hoặc gội).
model AppSwimBonusLog {
  id        String         @id @default(cuid())
  studentId String
  student   AppSwimStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Bơi tự do | Gội 30'
  purpose   String
  usedAt    DateTime       @default(now())

  @@index([studentId, usedAt])
  @@map("app_swim_bonus_logs")
}

// ─── Giải đấu (athlete check-in + one event-day voucher) ──────
// Mirrored from root prisma/schema.prisma. Do not db push this file.
// The voucher is issued once and redeemed once, at any sector.

model AppTournament {
  id          String   @id @default(cuid())
  name        String
  /// Inclusive start of the event window (Asia/Ho_Chi_Minh).
  startsAt    DateTime
  /// Exclusive end. Voucher and check-in are valid only inside [startsAt, endsAt).
  endsAt      DateTime
  /// UPCOMING | LIVE | ENDED
  status      String   @default("UPCOMING")
  /// Opaque QR token (tq_…) printed for athlete check-in. Not a customer QR.
  checkInToken String  @unique
  /// Court, e.g. Sân 2. Display only.
  court       String?
  /// Clock time on the event day, HH:mm. Display only; the voucher still covers the whole day.
  eventTime   String?
  /// First announced day. Kept when staff move the event, so the desk can show "dời về …".
  originalStartsAt DateTime?
  /// First announced clock, HH:mm. Null when the event was created without a time.
  originalEventTime String?
  summary     String?
  /// One athlete voucher. Same amount at every sector. 0 = no voucher.
  discountVnd          Int @default(50000)
  /// Unused. Kept so older rows still load. The form writes discountVnd only.
  miaOiDiscountVnd     Int @default(50000)
  olympicDiscountVnd   Int @default(0)
  spaDiscountVnd       Int @default(0)
  longNuongDiscountVnd Int @default(30000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checkIns AppTournamentCheckIn[]
  vouchers AppTournamentVoucher[]
  assets   AppTournamentAsset[]

  @@index([status, startsAt])
  @@index([startsAt])
  @@map("app_tournaments")
}

/// One attendance row per athlete per event. This is "giải tôi đã tham gia".
model AppTournamentCheckIn {
  id            String        @id @default(cuid())
  tournamentId  String
  tournament    AppTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  customerId    String
  customer      AppCustomer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// QR | STAFF | APP
  source        String        @default("QR")
  /// REGISTERED Tham gia | PRESENT Có mặt | NO_SHOW Không đến | CANCELLED Đã hủy
  attendance    String        @default("REGISTERED")
  /// Set only when the athlete checks in.
  checkedInAt   DateTime?
  createdAt     DateTime      @default(now())
  checkedByName String?

  @@unique([tournamentId, customerId])
  @@index([customerId, checkedInAt])
  @@map("app_tournament_check_ins")
}

/// One voucher per athlete per event. Redeemed once, at any sector.
model AppTournamentVoucher {
  id           String        @id @default(cuid())
  tournamentId String
  tournament   AppTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  customerId   String
  customer     AppCustomer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// ISSUED | REDEEMED | EXPIRED
  status       String        @default("ISSUED")
  /// Opaque one-time staff QR (tv_…). Null until the athlete opens the card.
  passToken    String?       @unique
  passExpiresAt DateTime?
  /// MIA_OI | OLYMPIC_POOL | SPA | LONG_NUONG — set once, when redeemed.
  redeemedZone String?
  redeemedVnd  Int?
  redeemedAt   DateTime?
  scannedByName String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  uses AppTournamentVoucherUse[]

  @@unique([tournamentId, customerId])
  @@index([customerId, status])
  @@index([tournamentId, status])
  @@map("app_tournament_vouchers")
}

/// Unused. A voucher is redeemed once; the zone is stored on the voucher.
model AppTournamentVoucherUse {
  id            String               @id @default(cuid())
  voucherId     String
  voucher       AppTournamentVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  zoneCode      String
  amountVnd     Int
  redeemedAt    DateTime             @default(now())
  scannedByName String?

  @@unique([voucherId, zoneCode])
  @@index([zoneCode, redeemedAt])
  @@map("app_tournament_voucher_uses")
}

/// One results image and one external gallery link per event. No photo album.
model AppTournamentAsset {
  id           String        @id @default(cuid())
  tournamentId String
  tournament   AppTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// RESULTS_IMAGE | GALLERY_LINK
  kind         String
  /// Stored image path, or an https gallery URL (Drive / Facebook).
  url          String
  label        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tournamentId, kind])
  @@map("app_tournament_assets")
}
