// Slim schema for Customer App only (faster generate + smaller client).
// Keep in sync with App* models in root prisma/schema.prisma.
//
// DANGER: NEVER run `prisma db push` with this schema against the shared DB.
// It will drop Control Tower / CRM tables. Use ONLY:
//   npx prisma generate --schema=prisma/schema.prisma
// Schema changes: edit root prisma/schema.prisma, then
//   npx prisma db push --schema=prisma/schema.prisma
// and mirror App* models here for generate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppCustomer {
  id           String   @id @default(cuid())
  customerCode String   @unique
  username     String   @unique
  passwordHash String
  status       String   @default("ACTIVE")
  fullName        String?
  phone           String?
  phoneNormalized String?  @unique
  /// 4 số cuối — chỉ dùng recovery/lookup, không phải ID chính
  phoneLast4      String?
  /// legacy alias kept in sync with phoneLast4
  shortId         String?
  /// WALK_IN | MEMBER | VIP
  segment         String   @default("WALK_IN")
  intendedServices String?
  adminConfirmedAt DateTime?
  adminNote        String?
  /// Opaque public token for My Oasis QR (never phone / raw DB id)
  identityToken    String?  @unique
  /// Loyalty tick points (check-in +5, redeem later)
  pointsBalance    Int      @default(0)
  /// Active VIP / membership package end (null = not VIP)
  vipExpiresAt     DateTime?
  vipPlanLabel     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AppCustomerSession[]
  devices  AppCustomerDevice[]
  events   AppServiceEvent[]
  orders   AppOrder[]
  bookings AppBooking[]
  serviceCarts AppServiceCart[]
  collectedOffers AppCollectedOffer[]
  pointLedger AppPointLedger[]
  offerClaimLogs AppOfferClaimLog[]
  voucherRedemptions AppVoucherRedemption[]

  @@index([status])
  @@index([createdAt])
  @@index([shortId])
  @@index([phoneLast4])
  @@index([segment])
  @@index([phoneNormalized])
  @@map("app_customers")
}

/// Point earn / redeem ledger (idempotent per ref).
model AppPointLedger {
  id           String   @id @default(cuid())
  customerId   String
  customer     AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  /// CHECKIN | REDEEM | ADJUST
  reason       String
  /// SERVICE_EVENT | SERVICE_CART | …
  refType      String?
  refId        String?
  note         String?
  createdAt    DateTime @default(now())

  @@unique([reason, refType, refId])
  @@index([customerId, createdAt])
  @@map("app_point_ledger")
}

/// Collected promo / voucher (Ưu đãi → Collect).
model AppCollectedOffer {
  id          String    @id @default(cuid())
  customerId  String
  customer    AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offerId     String
  status      String    @default("COLLECTED") // COLLECTED | USED | CANCELLED
  /// Tổng số lần (null = không giới hạn trong hạn gói, vd Mía %)
  qtyTotal     Int?
  /// Còn lại; 0 = hết lần nhưng thẻ vẫn hiện, không dùng thêm
  qtyRemaining Int?
  collectedAt DateTime  @default(now())
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([customerId, offerId])
  @@index([customerId, status])
  @@map("app_collected_offers")
}

model AppOfferClaimLog {
  id              String   @id @default(cuid())
  customerId      String
  customer        AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offerId         String
  offerTitle      String?
  zoneCode        String
  claimedByUserId String?
  claimedByName   String?
  phoneSnapshot   String?
  note            String?
  createdAt       DateTime @default(now())

  @@index([zoneCode, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("app_offer_claim_logs")
}

/// One-time QR for a Spa / Lòng Nướng voucher. Staff scan confirms it.
model AppVoucherRedemption {
  id            String    @id @default(cuid())
  /// Opaque QR token (vr_…)
  token         String    @unique
  customerId    String
  customer      AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offerId       String
  offerTitle    String
  /// SPA | LONG_NUONG
  zoneCode      String
  /// OPEN | SCANNED
  status        String    @default("OPEN")
  claimLogId    String?
  scannedAt     DateTime?
  scannedByName String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([customerId, offerId, status])
  @@index([expiresAt])
  @@map("app_voucher_redemptions")
}

/// Multi-select basket → one QR carrying all chosen services.
model AppServiceCart {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String
  customer   AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zoneCode   String
  zoneName   String?
  items      Json
  totalVnd   Int      @default(0)
  /// PENDING_APPROVAL | OPEN | USED | REJECTED | NO_SHOW | EXPIRED | CANCELLED
  status     String   @default("PENDING_APPROVAL")
  /// Staff reject reason (when REJECTED)
  adminNote  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, status, createdAt])
  @@index([expiresAt])
  @@map("app_service_carts")
}

/// Remember-this-device: cookie holds raw token; DB stores hash only.
model AppCustomerDevice {
  id         String    @id @default(cuid())
  customerId String
  customer   AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  events AppServiceEvent[]

  @@index([customerId])
  @@index([expiresAt])
  @@map("app_customer_devices")
}

model AppCustomerSession {
  id           String   @id @default(cuid())
  customerId   String
  customer     AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  lastUsedAt   DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
  @@map("app_customer_sessions")
}

model AppService {
  id          String   @id @default(cuid())
  serviceCode String   @unique
  serviceName String
  slug        String?  @unique
  qrToken     String?  @unique
  status      String   @default("ACTIVE")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events    AppServiceEvent[]
  orders    AppOrder[]
  bookings  AppBooking[]
  resources AppResource[]

  @@index([status])
  @@map("app_services")
}

model AppServiceEvent {
  id         String   @id @default(cuid())
  customerId String
  customer   AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    AppService  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  deviceId   String?
  device     AppCustomerDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  eventType  String   @default("SERVICE_USE")
  /// SERVICE_USE ops: NEW | ACKNOWLEDGED | IN_SERVICE | COMPLETED | CANCELLED | WRONG_SCAN
  operationalStatus String @default("NEW")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  orders AppOrder[]

  @@index([customerId, createdAt])
  @@index([serviceId, createdAt])
  @@index([customerId, serviceId, createdAt])
  @@index([deviceId])
  @@index([operationalStatus, createdAt])
  @@map("app_service_events")
}

model AppOrder {
  id         String   @id @default(cuid())
  customerId String
  customer   AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    AppService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceUseId String?
  serviceUse   AppServiceEvent? @relation(fields: [serviceUseId], references: [id], onDelete: SetNull)
  status     String   @default("PENDING")
  totalVnd   Int      @default(0)
  note       String?
  createdByType String @default("STAFF")
  createdById   String?
  source     String   @default("ZONE_DESK")
  idempotencyKey String? @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items AppOrderItem[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([serviceUseId])
  @@map("app_orders")
}

model AppOrderItem {
  id           String @id @default(cuid())
  orderId      String
  order        AppOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       String
  nameVi       String
  nameEn       String?
  unitPriceVnd Int
  qty          Int    @default(1)

  @@index([orderId])
  @@map("app_order_items")
}

model AppResource {
  id        String   @id @default(cuid())
  serviceId String
  service   AppService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type      String
  code      String
  name      String
  capacity  Int      @default(1)
  status    String   @default("AVAILABLE")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings AppBooking[]
  sessions AppResourceSession[]

  @@unique([serviceId, code])
  @@index([serviceId, type, sortOrder])
  @@map("app_resources")
}

model AppBooking {
  id                   String    @id @default(cuid())
  bookingCode          String    @unique
  customerId           String?
  customer             AppCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerNameSnapshot String?
  phone                String?
  phoneNormalized      String?
  serviceId            String
  service              AppService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  resourceId           String?
  resource             AppResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  startAt              DateTime
  endAt                DateTime
  partySize            Int       @default(1)
  status               String    @default("CONFIRMED")
  notes                String?
  source               String    @default("STAFF")
  createdByType        String?
  createdById          String?
  serviceUseId         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sessions AppResourceSession[]

  @@index([serviceId, startAt])
  @@index([customerId, startAt])
  @@index([phoneNormalized, startAt])
  @@index([resourceId, startAt])
  @@index([status, startAt])
  @@map("app_bookings")
}

model AppResourceSession {
  id         String    @id @default(cuid())
  resourceId String
  resource   AppResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  customerId String?
  bookingId  String?
  booking    AppBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  startAt    DateTime  @default(now())
  endAt      DateTime?
  status     String    @default("OCCUPIED")
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([resourceId, status])
  @@index([bookingId])
  @@map("app_resource_sessions")
}

/// Danh sách học viên bơi (đồng bộ DB với desk).
model AppSwimStudent {
  id               String    @id @default(cuid())
  fullName         String
  phone            String?
  phoneNormalized  String?
  packageId        String
  packageLabel     String
  sessionsTotal    Int       @default(0)
  sessionsLeft     Int       @default(0)
  bonusVisitsTotal Int       @default(0)
  bonusVisitsLeft  Int       @default(0)
  /// ACTIVE | PAUSED | DONE
  status           String    @default("ACTIVE")
  note             String?
  startedAt        DateTime  @default(now())
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([phoneNormalized])
  @@index([fullName])
  @@map("app_swim_students")
}
