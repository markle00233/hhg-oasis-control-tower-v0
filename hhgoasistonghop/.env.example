# Copy to .env for local, and set the same keys in Vercel → Settings → Environment Variables

# Required for NextAuth (Auth.js v5) — WITHOUT THIS → "Server error" on /api/auth/error
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Optional alias (same value)
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Production URL of the app (your Vercel domain)
AUTH_URL="https://hhgoasis-crm.vercel.app"
NEXTAUTH_URL="https://hhgoasis-crm.vercel.app"

# PostgreSQL connection string (Neon / Supabase / Prisma Postgres / Vercel Postgres)
# SQLite does NOT work on Vercel serverless
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
